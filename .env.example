# Copy to .env (git-ignored) at the repo root for local development. No value
# is ever committed. The API reads this file for whatever the environment
# leaves unset; the web app's dev server reads PORT and PUBLIC_ORIGIN from it.

# Where the API listens. The defaults suit local development.
HOST=127.0.0.1
PORT=3000

# The SQLite file and the Report button's folder. Empty means
# data/ro-housing.db and issues/ at the repo root.
RO_HOUSING_DB=
RO_HOUSING_ISSUES_DIR=

# The app's own origin as the browser sees it, bare. Empty means the Vite dev
# server, http://127.0.0.1:5173 (Vite's proxy fixes up localhost:5173 too).
PUBLIC_ORIGIN=
# More origins the API answers besides PUBLIC_ORIGIN, comma-separated. Empty
# means the Vite dev server under both names.
WEB_ORIGINS=

# Peers besides loopback whose X-Forwarded-For the login lockout believes:
# addresses or CIDR ranges, comma-separated. Empty is right locally.
AUTH_TRUSTED_PROXIES=

# The local account `cd api && npm run seed` makes; it asks on the terminal for
# whatever is empty here. An existing account is left as it is.
SEED_USERNAME=
SEED_PASSWORD=

# "Sign in with Ward" (optional). Ward's local seed writes these five. With
# WARD_OIDC_ISSUER empty the API runs with local accounts only.
# WARD_OIDC_CLIENT_KEY is a SECRET.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=

# "Fill the gaps" on a Saved draft (optional): Wicket, the estate's LLM queue.
# Both or neither; without them the draft has no button. WICKET_URL is Wicket's
# API base, like https://example.com/wicket-api. WICKET_TOKEN is a SECRET: this
# app's own token from Wicket's WICKET_APP_TOKENS.
WICKET_URL=
WICKET_TOKEN=
