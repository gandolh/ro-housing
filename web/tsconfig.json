{
  "extends": "../vendor/house-style/tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app, so the module settings are the bundler's, not NodeNext's.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    // The source imports `./App.tsx`: Vite and vitest resolve the real suffix.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
